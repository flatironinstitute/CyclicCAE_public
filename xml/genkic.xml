<ROSETTASCRIPTS>

    <SCOREFXNS>
      <!--Peptide ref2015 Scoring; _cart added for the MinMover 05-06-2025-->
      <ScoreFunction name="high_hbond" weights="ref2015_cart.wts">
        <Reweight scoretype="coordinate_constraint" weight="1"/>
        <Reweight scoretype="atom_pair_constraint" weight="1"/>
        <Reweight scoretype="dihedral_constraint" weight="1"/>
        <Reweight scoretype="angle_constraint" weight="1"/>
        <Reweight scoretype="hbond_lr_bb" weight="11.7"/>
        <Reweight scoretype="hbond_sr_bb" weight="11.7"/>
        <Set decompose_bb_hb_into_pair_energies="true"/>
      </ScoreFunction>
      <ScoreFunction name="default_reweight" weights="ref2015.wts">
        <Reweight scoretype="chainbreak" weight="20"/>
      </ScoreFunction>
      <ScoreFunction name="default" weights="ref2015.wts"/>
    </SCOREFXNS>

    <RESIDUE_SELECTORS>
      <Index name="anchor" resnums="4"/>
      <Index name="peptide" resnums="1,2,3,4,5,6,7,8"/>
    </RESIDUE_SELECTORS>

    <TASKOPERATIONS>
    </TASKOPERATIONS>

    <MOVE_MAP_FACTORIES>
    </MOVE_MAP_FACTORIES>

    <SIMPLE_METRICS>
    </SIMPLE_METRICS>

    <FILTERS>
      <Time name="timer"/>
    </FILTERS>

    <MOVERS>
      <PeptideStubMover name="extension" reset="false">
        <Append resname="GLY" repeat="8"/>
      </PeptideStubMover>

      <SetTorsion name="set_omega_torsion" foldtree_root="4">
        <Torsion residue="1,2,3,4,5,6,7,8" torsion_name="omega" angle="180"/>
      </SetTorsion>

      <DumpPdb name="savepdb" fname="post_stubmover.pdb"
        scorefxn="high_hbond" />

      <MinMover name="minmover" 
        scorefxn="high_hbond" 
        bondangle="true"
        bondlength="true"
        chi="true"
        bb="true"
        omega="true"/>

      <PeptideCyclizeMover name="close" residue_selector="peptide"/>

      <GeneralizedKIC name="genkic"
        closure_attempts="500"
        stop_when_n_solutions_found="1"
        selector="lowest_energy_selector"
        selector_scorefunction="high_hbond">

        <AddResidue res_index="5"/>
        <AddResidue res_index="6"/>
        <AddResidue res_index="7"/>
        <AddResidue res_index="8"/>
        <AddResidue res_index="1"/>
        <AddResidue res_index="2"/>
        <AddResidue res_index="3"/>

        <CloseBond res1="8" atom1="C" res2="1" atom2="N" bondlength="1.32" angle1="114" angle2="123" torsion="180"/>
        <SetPivots res1="5" res2="8" res3="3" atom1="CA" atom2="CA" atom3="CA"/>
        <AddPerturber effect="randomize_alpha_backbone_by_rama" custom_rama_table="flat_symm_dl_aa_ramatable">
          <AddResidue index="1"/>
          <AddResidue index="2"/>
          <AddResidue index="6"/>
          <AddResidue index="7"/>
        </AddPerturber>
        <AddFilter type="loop_bump_check"/>

        <AddFilter type="rama_prepro_check" residue="5" rama_cutoff_energy="2"/>
        <AddFilter type="rama_prepro_check" residue="6" rama_cutoff_energy="2"/>
        <AddFilter type="rama_prepro_check" residue="7" rama_cutoff_energy="2"/>
        <AddFilter type="rama_prepro_check" residue="8" rama_cutoff_energy="2"/>
        <AddFilter type="rama_prepro_check" residue="1" rama_cutoff_energy="2"/>
        <AddFilter type="rama_prepro_check" residue="2" rama_cutoff_energy="2"/>
        <AddFilter type="rama_prepro_check" residue="3" rama_cutoff_energy="2"/>

      </GeneralizedKIC>

    </MOVERS>

    <PROTOCOLS>
      <Add filter="timer"/>
      <Add mover="extension"/>
      <Add mover="set_omega_torsion"/>
      <Add mover="close"/>
      <Add mover="genkic"/>
      <Add mover="minmover"/>
      <Add filter="timer"/>
    </PROTOCOLS>
    <OUTPUT scorefxn="default"/>

</ROSETTASCRIPTS>
