<!--Script written by Andrew Powers (apowers@flatironinstitute.org & apowers4@uoregon.edu)
  Increase dataset, but perturbing dihedrals in order to teach the model good and bad geometries
-->

<ROSETTASCRIPTS>

    <SCOREFXNS>
      <!--Peptide ref2015 Scoring-->
      <ScoreFunction name="high_hbond" weights="ref2015.wts">
        <Reweight scoretype="coordinate_constraint" weight="1"/>
        <Reweight scoretype="atom_pair_constraint" weight="1"/>
        <Reweight scoretype="dihedral_constraint" weight="1"/>
        <Reweight scoretype="angle_constraint" weight="1"/>
        <Reweight scoretype="hbond_lr_bb" weight="11.7"/>
        <Reweight scoretype="hbond_sr_bb" weight="11.7"/>
        <Set decompose_bb_hb_into_pair_energies="true"/>
      </ScoreFunction>
      <!-- New ScoreFunctions that are used after/before mover-->
      <ScoreFunction name="default" weights="ref2015.wts"/>
      <ScoreFunction name="default_fasol" weights="/mnt/home/vmulligan/ceph/2024_02_02_polygly_macrocycle_conf_embedding/8mer/organic/8mer_polysar_organic_dftb_smd_cartmin_geoopt/inputs/ref2015_without_fasol.wts"/>
      <ScoreFunction name="default_qm" weights="/mnt/home/vmulligan/ceph/2024_02_02_polygly_macrocycle_conf_embedding/8mer/organic/8mer_polysar_organic_dftb_smd_cartmin_geoopt/inputs/dftb_smd_organic.wts"/>
    </SCOREFXNS>

    <RESIDUE_SELECTORS>
      <!--Grab the entire peptide-->
      <Chain name="peptide" chains="A"/>
    </RESIDUE_SELECTORS>

    <TASKOPERATIONS>
    </TASKOPERATIONS>

    <MOVE_MAP_FACTORIES>
    </MOVE_MAP_FACTORIES>

    <SIMPLE_METRICS>
      <TotalEnergyMetric name="score_default" custom_type="default" scoretype="total_score" scorefxn="default" residue_selector="peptide"/>
      <TotalEnergyMetric name="scorefasol" custom_type="fasol" scoretype="total_score" scorefxn="default_fasol" residue_selector="peptide"/>
      <TotalEnergyMetric name="scoreqm" custom_type="qm" scoretype="gamess_qm_energy" scorefxn="default_qm"/>
    </SIMPLE_METRICS>

    <FILTERS>
    </FILTERS>

    <MOVERS>
      <!--Perturb the backbone-torsion angles for the given selector-->
      <Small name="perturb_backbone"
        scorefxn="default"
        temperature="1"
        nmoves="1000"
        angle_max="4.0"
        preserve_detailed_balance="1"/>
      <!-- Preserve is 1, because it will always accept a move then-->

      <!-- Make sure that the terminal bond is present-->
      <PeptideCyclizeMover name="cyclize" residue_selector="peptide"/>

      <!-- Run simple metric for calculating the total score-->
      <RunSimpleMetrics name="post_score_total" metrics="scorefasol,scoreqm,score_default" prefix="post_"/>
      <RunSimpleMetrics name="pre_score_total" metrics="scorefasol,scoreqm,score_default" prefix="pre_"/>

    </MOVERS>

    <PROTOCOLS>
      <!--Pre Score Peptide-->
      <Add mover="pre_score_total"/>
      <!--Pertrub Peptide Torsion-->
      <Add mover="perturb_backbone"/>
      <!--Add cyclic terminal petpide bond-->
      <Add mover="cyclize"/>
      <!--ReScore Peptide-->
      <Add mover="post_score_total"/>
    </PROTOCOLS>

    <OUTPUT scorefxn="default"/>

  </ROSETTASCRIPTS>
